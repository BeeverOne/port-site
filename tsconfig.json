{
  "extends": "./site/tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ESNext",
    "allowJs": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["site/.astro/types.d.ts", "site/**/*"],
  "exclude": ["site/dist", "site/node_modules", "base"]
}
