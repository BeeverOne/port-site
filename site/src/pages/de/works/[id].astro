---
/* /de/works/<id>: eine vorgerenderte Seite je veröffentlichtem Projekt (FR-14, FR-15, ADR-0006). */
import SitePage from '../../../components/SitePage.astro';
import { siteProjects } from '../../../lib/projects.js';

export async function getStaticPaths() {
  return (await siteProjects()).map((p) => ({ params: { id: p.id } }));
}
const { id } = Astro.params;
---

<SitePage lang="de" view="project" projectId={id} />
