---
/* /de/works/<id>: eine vorgerenderte Seite je veröffentlichtem Projekt (FR-14, FR-15, ADR-0006). */
import { getCollection } from 'astro:content';
import SitePage from '../../../components/SitePage.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((p) => ({ params: { id: p.id } }));
}
const { id } = Astro.params;
---

<SitePage lang="de" view="project" projectId={id} />
