---
/* Interactive component preview "circle-size" (FR-17, ADR-0008). Loaded only inside the detail view,
   in an iframe with sandbox="allow-scripts" and no allow-same-origin: it runs in an opaque origin
   and cannot reach the site's DOM, storage or cookies. It is self-contained (system font, inline
   script) because an opaque origin cannot use the site's fonts or bundles. ?lang=de switches the
   label. New previews are pages next to this one plus an option in keystatic.config.ts. */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Circle size</title>
    <style>
      :root { color-scheme: light dark; --bg: #0f5c55; --ink: #f1f7f4; --accent: #b6f09c; }
      @media (prefers-color-scheme: dark) { :root { --bg: #26282c; --ink: #ffffff; --accent: #ff6a2b; } }
      html, body { height: 100%; margin: 0; }
      body {
        display: flex; align-items: center; justify-content: center; gap: 28px; flex-wrap: wrap; padding: 16px;
        box-sizing: border-box; background: var(--bg); color: var(--ink); font: 600 15px/1.3 system-ui, sans-serif;
      }
      label { display: flex; flex-direction: column; gap: 10px; }
      input { width: min(240px, 60vw); accent-color: var(--accent); }
      .swatch { width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; }
      .swatch i { display: block; width: 24px; height: 24px; border-radius: 50%; background: var(--accent); }
    </style>
  </head>
  <body>
    <label><span id="label">Circle size</span><input type="range" id="size" min="4" max="56" value="24" /></label>
    <div class="swatch" aria-hidden="true"><i id="dot"></i></div>
    <script is:inline>
      if (new URLSearchParams(location.search).get('lang') === 'de') {
        document.documentElement.lang = 'de';
        document.getElementById('label').textContent = 'Kreisgröße';
      }
      const dot = document.getElementById('dot');
      document.getElementById('size').addEventListener('input', (e) => {
        dot.style.width = dot.style.height = e.target.value + 'px';
      });
    </script>
  </body>
</html>
