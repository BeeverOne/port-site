---
/* /works/<id>: one pre-rendered page per published project (FR-14, FR-15, ADR-0006). */
import SitePage from '../../components/SitePage.astro';
import { siteProjects } from '../../lib/projects.js';

export async function getStaticPaths() {
  return (await siteProjects()).map((p) => ({ params: { id: p.id } }));
}
const { id } = Astro.params;
---

<SitePage lang="en" view="project" projectId={id} />
