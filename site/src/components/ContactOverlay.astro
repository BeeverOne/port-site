---
/* Contact overlay (FR-25 to FR-37). Opens on top of the current section with
   <dialog>.showModal(). The form posts to /api/contact (src/pages/api/contact.js), which checks
   the fields, verifies the Turnstile token and sends the mail through Resend (FR-28 to FR-36).
   The Turnstile widget renders into .turnstile the first time the overlay opens, so Cloudflare
   is only contacted by visitors who open the form (privacy policy, section on Turnstile). */
---

<dialog class="contact" id="contact" aria-labelledby="contactTitle">
  <form class="contact-inner" id="contactForm" novalidate>
    <div class="contact-head">
      <h2 id="contactTitle" data-i18n="contactTitle">Contact</h2>
      <button class="close cb" type="button" id="contactClose" data-i18n="close">[ Close ]</button>
    </div>
    <div class="field" id="f-name">
      <label for="name" data-i18n="name">Name</label><input id="name" name="name" autocomplete="name" aria-describedby="e-name"
      /><span class="err" id="e-name"></span>
    </div>
    <div class="field" id="f-email">
      <label for="email" data-i18n="email">Email</label><input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        aria-describedby="e-email"
      /><span class="err" id="e-email"></span>
    </div>
    <div class="field" id="f-message">
      <label for="message" data-i18n="message">Message</label><textarea
        id="message"
        name="message"
        maxlength="3000"
        aria-describedby="e-message count"></textarea><span class="counter" id="count">0 / 3000</span
      ><span class="err" id="e-message"></span>
    </div>
    <div class="turnstile"></div>
    <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap">
      <button class="btn btn-primary cb" type="submit" id="sendBtn" data-i18n="send">Send</button>
      <span class="status" id="status" role="status" aria-live="polite"></span>
    </div>
  </form>
</dialog>
