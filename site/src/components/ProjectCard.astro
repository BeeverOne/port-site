---
/* One project card (FR-10). Rendered from the content collection; localizeCards()
   in site.js rewrites the text when the visitor switches language (FR-21, FR-22). */
const { id, headline, title, year, tags } = Astro.props;
---

<a class="card cb" href={`#/works/${id}`} data-id={id}
  ><div class="thumb"><span>Project thumbnail</span></div><h3>{headline}</h3><div class="meta"
    ><span class="t">{title}</span><span class="year">{year}</span></div
  ><div class="tags">{tags.map((t) => <span>{t}</span>)}</div></a
>
