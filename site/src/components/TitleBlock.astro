---
import R1Mark from './marks/R1Mark.astro';

/* Drawing-sheet title block. Used at the end of the intro (sheet 1) and in the
   works head (sheet 2); only the sheet row differs. */
const { sheet, sheetText } = Astro.props;
---

<div class="titleblock">
  <div class="tb-name"><R1Mark size={22} /><span>Oluwafemi Bamigboye</span></div>
  <div class="tb-grid">
    <div>
      <span class="k" data-i18n="discipline">Discipline</span><span data-i18n="softdev">Software development</span>
    </div>
    <div><span class="k" data-i18n="sheet">Sheet</span><span data-i18n={sheet}>{sheetText}</span></div>
    <div><span class="k" data-i18n="revision">Revision</span><span>v1</span></div>
    <div><span class="k" data-i18n="site">Site</span><span>reverb-one.space</span></div>
  </div>
</div>
