---
/* The one-page site (ADR-0006, ADR-0012). Six routes render it: /, /works and /works/<id> in English,
   and the same under /de/ in German. Each is pre-rendered in its own language with its own title and
   hreflang alternates; site.js reads the address to decide where the view starts (intro, works, or
   a project's detail view) and moves between these URLs with the History API, so in-page
   navigation never loads a new document (FR-13, FR-21). */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageLoader from './PageLoader.astro';
import SiteHeader from './SiteHeader.astro';
import Intro from './Intro.astro';
import Works from './Works.astro';
import ProjectDetail from './ProjectDetail.astro';
import ContactOverlay from './ContactOverlay.astro';
import ProtoControls from './ProtoControls.astro';

/* lang: 'en' | 'de'. view: 'intro' | 'works' | 'project'. projectId: set when view is 'project'. */
const { lang = 'en', view = 'intro', projectId } = Astro.props;

/* Published projects in the owner's order (FR-11, FR-40). */
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const project = projectId ? projects.find((p) => p.id === projectId)?.data[lang] : undefined;

/* The cards are server-rendered; this island carries the same fields in both
   languages so the client can localise the track and the detail view (FR-10, FR-22). */
const projectData = projects.map(({ id, data }) => ({ id, en: data.en, de: data.de }));

const site = 're.verb one';
const title =
  view === 'project' && project
    ? `${project.headline} - ${site}`
    : view === 'works'
      ? `${lang === 'de' ? 'Arbeiten' : 'Works'} - ${site}`
      : `${site} - Oluwafemi Bamigboye`;
const path = view === 'project' ? `/works/${projectId}` : view === 'works' ? '/works' : '/';
const alternates = { en: path, de: path === '/' ? '/de/' : `/de${path}` };
---

<Base title={title} lang={lang} alternates={alternates}>
  <PageLoader lang={lang} />
  <SiteHeader lang={lang} />

  <!-- Content island: one scroll container owns the intro, the runway and the works
       section; the grain canvas, the edge blur and the detail view layer inside it. -->
  <div class="island" id="island">
    <div class="plus-field" aria-hidden="true"></div>
    <!-- grain transition (FR-02, FR-03), an animation of its own triggered by the scroll (CR-22) -->
    <canvas id="grain" aria-hidden="true"></canvas>
    <div class="scroller" id="scroller" tabindex="-1">
      <Intro lang={lang} />
      <!-- runway: layout() sizes this spacer to the transition's scroll distance -->
      <div class="runway" id="runway" aria-hidden="true"></div>
      <Works projects={projects} lang={lang} />
    </div>
    <div class="edge-blur" id="edgeBlur" aria-hidden="true"><div></div><div></div><div></div></div>
    <ProjectDetail lang={lang} project={project} />
  </div>

  <ContactOverlay lang={lang} />
  {import.meta.env.DEV && <ProtoControls />}

  <!-- is:inline: a JSON payload, not a module — Astro must not try to bundle it. -->
  <script type="application/json" id="projects-data" is:inline set:html={JSON.stringify(projectData)} />
  <script>
    import '../scripts/site.js';
  </script>
</Base>
