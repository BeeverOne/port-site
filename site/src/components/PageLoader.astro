---
import VStack from './marks/VStack.astro';
import { dict } from '../i18n/server.js';

const { lang = 'en' } = Astro.props;
---

<!-- Page loader (FR-47 to FR-49, FR-52): the v-stack wordmark fills from bottom to top.
     .base is the faint outline, .fillmark is the clip-path reveal on top of it. -->
<div class="loader run" id="loader" role="status" aria-live="polite">
  <div class="lmark" aria-hidden="true"
    ><VStack markClass="base" width={200} height={96} /><VStack markClass="fillmark" width={200} height={96} /></div
  >
  <span class="sr-only" data-i18n="loading">{dict(lang).loading}</span>
</div>
