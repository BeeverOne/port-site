---
import '../styles/global.css';

const { title = 're.verb one - Oluwafemi Bamigboye' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="re.verb one - Oluwafemi Bamigboye, software developer." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..800&family=Unbounded:wght@400..600&display=swap"
      rel="stylesheet"
    />
  </head>
  <!-- v2: the page itself never scrolls; the content island's scroller owns vertical scroll. -->
  <body>
    <slot />
  </body>
</html>
