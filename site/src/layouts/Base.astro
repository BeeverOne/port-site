---
import '../styles/fonts.css';
import '../styles/global.css';

const DESCRIPTION = {
  en: 're.verb one - Oluwafemi Bamigboye, software developer.',
  de: 're.verb one - Oluwafemi Bamigboye, Softwareentwickler.',
};
const { title = 're.verb one - Oluwafemi Bamigboye', lang = 'en', bodyClass, description = DESCRIPTION[lang], alternates } =
  Astro.props;
/* ADR-0012: every page exists in English at the root and in German under /de/. alternates names
   both paths so search engines can pair them; English is the x-default. */
const abs = (path) => new URL(path, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <!-- Dark artwork for light tabs, light artwork for dark tabs: the brand asset pair. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    {
      alternates && (
        <>
          <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
          <link rel="alternate" hreflang="de" href={abs(alternates.de)} />
          <link rel="alternate" hreflang="x-default" href={abs(alternates.en)} />
        </>
      )
    }
    <!-- Link previews (iMessage, WhatsApp, Slack, Discord): Open Graph. Crawlers fetch
         server-side, so og:url and og:image must be absolute; Astro.site supplies the domain. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="re.verb one" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <!-- The R1 logo on black (R1-Assets/r1-logo-1024-bg.png). Bump ?v= whenever og.png changes:
         chat apps cache previews by image URL, so a new query string forces a fresh fetch. -->
    <meta property="og:image" content={new URL('/og.png?v=2', Astro.site)} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="The R1 logo, light grey on black" />
    <!-- summary: the image is square, so the small square card fits it without cropping. -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image:alt" content="The R1 logo, light grey on black" />
    <!-- Self-hosted fonts (src/styles/fonts.css): preloaded so the page loader, which waits for
         document.fonts.ready, is not held up by a late font request. -->
    <link rel="preload" href="/fonts/archivo-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/unbounded-latin-var.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <!-- v2: the page itself never scrolls; the content island's scroller owns vertical scroll.
       Pages that scroll normally (the legal pages) pass bodyClass. -->
  <body class={bodyClass}>
    <slot />
  </body>
</html>
