---
import '../styles/global.css';

const { title = 're.verb one - Oluwafemi Bamigboye' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <!-- Dark artwork for light tabs, light artwork for dark tabs: the brand asset pair. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
    <meta name="description" content="re.verb one - Oluwafemi Bamigboye, software developer." />
    <!-- Link previews (iMessage, WhatsApp, Slack, Discord): Open Graph. Crawlers fetch
         server-side, so og:url and og:image must be absolute; Astro.site supplies the domain. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="re.verb one" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="re.verb one - Oluwafemi Bamigboye, software developer." />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <!-- The R1 logo on black (R1-Assets/r1-logo-1024-bg.png). Bump ?v= whenever og.png changes:
         chat apps cache previews by image URL, so a new query string forces a fresh fetch. -->
    <meta property="og:image" content={new URL('/og.png?v=2', Astro.site)} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="The R1 logo, light grey on black" />
    <!-- summary: the image is square, so the small square card fits it without cropping. -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image:alt" content="The R1 logo, light grey on black" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..800&family=Unbounded:wght@400..600&display=swap"
      rel="stylesheet"
    />
  </head>
  <!-- v2: the page itself never scrolls; the content island's scroller owns vertical scroll. -->
  <body>
    <slot />
  </body>
</html>
